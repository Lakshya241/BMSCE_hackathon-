# ============================================================
# Chain Sentry BACKEND — environment
# Copy to backend/.env for LIVE MST anchoring.
# Without these, the backend runs DEMO MODE: transactions are
# real SHA-256 digests but clearly labeled SIMULATED / DEMO.
# ============================================================

PORT=4000

# --- MST Blockchain (EVM-compatible) ---
# MST Testnet — chainId 91562037, native token tMSTC
# Explorer: https://testnet.mstscan.com   Faucet: https://faucet.mstblockchain.com
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_PRIVATE_KEY=0x189728529b1f68c9d1f0dcc0b96ac623f14d1ba0295db69ee4a5e12d492828b2
MST_CONTRACT_ADDRESS=0x1445f17652E5F03cA3bE3671aeaf7adF9ded0266
MST_CHAIN_ID=91562037
MST_EXPLORER_URL=https://testnet.mstscan.com

# CORS origin of the frontend
FRONTEND_ORIGIN=http://localhost:3000
